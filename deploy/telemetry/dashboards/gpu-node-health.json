{
 "uid": "gpu-node-health",
 "title": "GPU Node Health",
 "description": "Health of the GPU hang detection chain itself, and what it currently sees. Built for the August 2026 hang failure mode: the expensive part was not a GPU dying, it was that nothing noticed. Panels are ordered so that 'is the chain alive' comes before 'what is the chain reporting'.",
 "tags": [
  "gpu",
  "health",
  "amd"
 ],
 "editable": true,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "timezone": "browser",
 "graphTooltip": 1,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "timepicker": {
  "refresh_intervals": [
   "10s",
   "30s",
   "1m",
   "5m",
   "15m",
   "1h"
  ]
 },
 "annotations": {
  "list": []
 },
 "templating": {
  "list": [
   {
    "type": "datasource",
    "name": "DS",
    "label": "Data source",
    "query": "prometheus",
    "current": {},
    "hide": 0,
    "refresh": 1,
    "regex": "",
    "skipUrlSync": false
   },
   {
    "type": "query",
    "name": "node",
    "label": "Node",
    "datasource": {
     "type": "prometheus",
     "uid": "${DS}"
    },
    "hide": 0,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "refresh": 2,
    "sort": 1,
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ],
     "selected": true
    },
    "definition": "label_values(up, node)",
    "query": {
     "qryType": 1,
     "query": "label_values(up, node)",
     "refId": "node"
    },
    "options": [],
    "skipUrlSync": false
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Agents reporting",
   "description": "Health agents currently scrapeable. Compare with 'Nodes enrolled' to the right: enrolled > reporting means a node stopped being monitored, which reads from every other panel as a healthy node.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#0ca30c",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "auto",
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "auto",
    "wideLayout": true
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "editorMode": "code",
     "expr": "sum(gpuhealth_agent_up) OR on() vector(0)",
     "refId": "A",
     "range": false,
     "instant": true,
     "format": "time_series"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Nodes enrolled",
   "description": "Nodes carrying gpu-health.amd.io/agent=true, read off the API server.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#3987e5",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "auto",
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "auto",
    "wideLayout": true
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "editorMode": "code",
     "expr": "count(kube_node_labels{label_gpu_health_amd_io_agent=\"true\"}) OR on() vector(0)",
     "refId": "A",
     "range": false,
     "instant": true,
     "format": "time_series"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Conditions active",
   "description": "Any GPU health condition currently raised anywhere in the fleet.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#0ca30c",
        "value": null
       },
       {
        "color": "#d03b3b",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "auto",
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "auto",
    "wideLayout": true
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "editorMode": "code",
     "expr": "sum(gpuhealth_condition) OR on() vector(0)",
     "refId": "A",
     "range": false,
     "instant": true,
     "format": "time_series"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "GPUs healthy",
   "description": "gpu_health==1, summed. Against 16 total on the two serving nodes.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#0ca30c",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "auto",
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "auto",
    "wideLayout": true
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "editorMode": "code",
     "expr": "sum(gpu_health) OR on() vector(0)",
     "refId": "A",
     "range": false,
     "instant": true,
     "format": "time_series"
    }
   ]
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Exporters down",
   "description": "The operator's exporter DaemonSet has no readiness or liveness probe, so a dead exporter still shows 1/1 Running and stays a Ready endpoint. This tile is one of the only places that difference is visible.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#0ca30c",
        "value": null
       },
       {
        "color": "#fab219",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "auto",
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "auto",
    "wideLayout": true
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "editorMode": "code",
     "expr": "count(up{job=\"amd-gpu-exporter\"} == 0) OR on() vector(0)",
     "refId": "A",
     "range": false,
     "instant": true,
     "format": "time_series"
    }
   ]
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Critical alerts firing",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#0ca30c",
        "value": null
       },
       {
        "color": "#d03b3b",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "auto",
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "auto",
    "wideLayout": true
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "editorMode": "code",
     "expr": "count(ALERTS{alertstate=\"firing\", severity=\"critical\"}) OR on() vector(0)",
     "refId": "A",
     "range": false,
     "instant": true,
     "format": "time_series"
    }
   ]
  },
  {
   "id": 10,
   "type": "state-timeline",
   "title": "Node conditions",
   "description": "Conditions are driven by activity in a rolling 15-minute window, not by cumulative counters: a node that reset a GPU three weeks ago is not currently unrecoverable. GPUHealthDataStale means the agent could not read its own inputs - treat that node as UNKNOWN, not healthy.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 0,
      "fillOpacity": 85,
      "spanNulls": false,
      "insertNulls": false,
      "hideFrom": {
       "legend": false,
       "tooltip": false,
       "viz": false
      }
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "OK",
         "color": "#0ca30c",
         "index": 0
        },
        "1": {
         "text": "ACTIVE",
         "color": "#d03b3b",
         "index": 1
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "mergeValues": true,
    "showValue": "auto",
    "alignValue": "center",
    "rowHeight": 0.9,
    "perPage": 20,
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "single",
     "sort": "none"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "editorMode": "code",
     "expr": "max by (node, condition) (gpuhealth_condition{node=~\"$node\"})",
     "refId": "A",
     "range": true,
     "instant": false,
     "format": "time_series",
     "legendFormat": "{{node}} · {{condition}}"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Kernel events (15m increase)",
   "description": "Straight off the kernel log counters, independent of the Node Condition path - so it still shows up if condition publishing is off or broken. Read from /var/log/kern.log and /var/log/syslog, never dmesg: dmesg is a ring buffer and had already wrapped on every long-uptime node in this fleet.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "drawStyle": "bars",
      "lineInterpolation": "linear",
      "lineWidth": 2,
      "fillOpacity": 70,
      "gradientMode": "none",
      "showPoints": "auto",
      "pointSize": 8,
      "spanNulls": false,
      "barAlignment": 0,
      "axisBorderShow": false,
      "axisGridShow": true,
      "scaleDistribution": {
       "type": "linear"
      },
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "thresholdsStyle": {
       "mode": "off"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*\\(fatal\\).*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#d03b3b"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*\\(warning\\).*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#fab219"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true,
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "editorMode": "code",
     "expr": "sum by (rule, severity) (increase(gpuhealth_kernlog_events_total{node=~\"$node\"}[15m]))",
     "refId": "A",
     "range": true,
     "instant": false,
     "format": "time_series",
     "legendFormat": "{{rule}} ({{severity}})"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "D-state GPU workers stuck",
   "description": "kworker/u26*+ttm wedged in uninterruptible sleep. This is the only early signal of the silent variant of the hang: the node looks entirely healthy from outside while each GPU scheduling context freezes in turn.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "drawStyle": "line",
      "lineInterpolation": "linear",
      "lineWidth": 2,
      "fillOpacity": 0,
      "gradientMode": "none",
      "showPoints": "auto",
      "pointSize": 8,
      "spanNulls": false,
      "barAlignment": 0,
      "axisBorderShow": false,
      "axisGridShow": true,
      "scaleDistribution": {
       "type": "linear"
      },
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       },
       {
        "color": "#d03b3b",
        "value": 1
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*0024.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3987e5"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*0029.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#d95926"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*0043.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#199e70"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*0004.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#c98500"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*0005.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#d55181"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*0006.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#008300"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true,
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "editorMode": "code",
     "expr": "gpuhealth_dstate_stuck_processes{node=~\"$node\", scope=\"gpu_worker\"}",
     "refId": "A",
     "range": true,
     "instant": false,
     "format": "time_series",
     "legendFormat": "{{node}}"
    }
   ]
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Age of last successful collection",
   "description": "An agent that answers /metrics but stopped collecting serves a cached all-clear. Dashed line is the GPUHealthCollectStale threshold (120s).",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "line",
      "lineInterpolation": "linear",
      "lineWidth": 2,
      "fillOpacity": 0,
      "gradientMode": "none",
      "showPoints": "auto",
      "pointSize": 8,
      "spanNulls": false,
      "barAlignment": 0,
      "axisBorderShow": false,
      "axisGridShow": true,
      "scaleDistribution": {
       "type": "linear"
      },
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       },
       {
        "color": "#d03b3b",
        "value": 120
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*0024.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3987e5"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*0029.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#d95926"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*0043.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#199e70"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*0004.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#c98500"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*0005.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#d55181"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*0006.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#008300"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true,
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "editorMode": "code",
     "expr": "time() - gpuhealth_collect_timestamp_seconds{node=~\"$node\"}",
     "refId": "A",
     "range": true,
     "instant": false,
     "format": "time_series",
     "legendFormat": "{{node}}"
