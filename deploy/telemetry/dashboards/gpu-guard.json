  {
   "id": 10,
   "type": "timeseries",
   "title": "Metrics-exporter unreachable",
   "description": "How long each exporter has failed to answer /metrics. Only a successful scrape resets this - never a restart, never a delete, never a Running phase. That matters here: the operator's DaemonSet has neither a readiness nor a liveness probe, so a dead exporter reads 1/1 Running indefinitely, and this counter is the only thing that tells it apart from a healthy one. Grouped by exporter_pod, not pod: `pod` on this series is the guard's own.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "line",
      "lineInterpolation": "linear",
      "lineWidth": 2,
      "fillOpacity": 10,
      "gradientMode": "none",
      "showPoints": "auto",
      "pointSize": 8,
      "spanNulls": false,
      "barAlignment": 0,
      "axisBorderShow": false,
      "axisGridShow": true,
      "scaleDistribution": {
       "type": "linear"
      },
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       },
       {
        "color": "#d03b3b",
        "value": 900
