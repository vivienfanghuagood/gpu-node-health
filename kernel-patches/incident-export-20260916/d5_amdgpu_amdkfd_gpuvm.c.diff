--- a/amd/amdgpu/amdgpu_amdkfd_gpuvm.c
+++ b/amd/amdgpu/amdgpu_amdkfd_gpuvm.c
@@ -1108,7 +1108,17 @@
 
 	mutex_lock(&process_info->lock);
 
-	ret = amdgpu_ttm_tt_set_userptr(&bo->tbo, user_addr, 0);
+	/* D5: if the caller did not request a GPU-writable mapping, the BO
+	 * only needs read access to the host pages. Pin them read-only so
+	 * read-only (e.g. PROT_READ file-backed) mappings can be registered
+	 * instead of failing with -EPERM.
+	 */
+	uint32_t userptr_flags = 0;
+
+	if (!(mem->alloc_flags & KFD_IOC_ALLOC_MEM_FLAGS_WRITABLE))
+		userptr_flags |= AMDGPU_GEM_USERPTR_READONLY;
+
+	ret = amdgpu_ttm_tt_set_userptr(&bo->tbo, user_addr, userptr_flags);
 	if (ret) {
 		pr_err("%s: Failed to set userptr: %d\n", __func__, ret);
 		goto out;
