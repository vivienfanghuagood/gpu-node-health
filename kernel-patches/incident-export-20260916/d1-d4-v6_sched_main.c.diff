+/* D4/D1: force-complete finished fences stalled on a context whose
+ * completion processing has demonstrably failed (watchdog expired).
+ * Signaling with -ECANCELED releases TTM/waiters and breaks the
+ * infinite-wait deadlock. Only called for contexts already past the
+ * engine-timeout recovery window, so the hw side is settled.
+ */
+static void d4_remediate_stalled_ctx(struct drm_gpu_scheduler *sched,
+				     u64 context)
+{
+	struct drm_sched_job *job;
+	int n = 0;
+
+	spin_lock(&sched->job_list_lock);
+	list_for_each_entry(job, &sched->pending_list, list) {
+		struct dma_fence *fin = &job->s_fence->finished;
+
+		if (fin->context != context || dma_fence_is_signaled(fin))
+			continue;
+		dma_fence_set_error(fin, -ECANCELED);
+		dma_fence_signal(fin);
+		n++;
+	}
+	spin_unlock(&sched->job_list_lock);
+	if (n)
+		dev_warn(sched->dev,
+			 "drm_sched %s: D1 remediate: force-signaled %d stalled fence(s) on context %llu with -ECANCELED\n",
+			 sched->name, n, context);
+}
